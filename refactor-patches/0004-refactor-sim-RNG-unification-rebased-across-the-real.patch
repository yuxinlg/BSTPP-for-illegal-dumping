+    model = Hawkes_Model(DATA, A_GDF, T_DAYS, cox_background=cox, **PRIORS)
+    if cox == "cox":
+        tr = handlers.trace(handlers.seed(model.model,
+                                          jax.random.PRNGKey(3))).get_trace(model.args)
