From a658aa5be5949fd35394387fc8026337fc3896eb Mon Sep 17 00:00:00 2001
From: "Phase1 Draft (Claude, for Terhi review)" <draft@local>
Date: Sun, 12 Jul 2026 13:20:25 +0000
Subject: [PATCH 1/3] refactor(model-fn purity): the numpyro model functions no
 longer mutate args. Deletes (1) the redundant covariate ndim reshape inside
 spatiotemporal_hawkes_model -- the constructor already guarantees 2-D via
 X_s[:, None] before writing args['spatial_cov'] (verified at main.py,
 covariate processing block), so the model-side block was a per-trace
 data-contract fix that also wrote back into shared state; (2) the four
 self-assignments args['coords'|'t_vals'|'x_vals'|'y_vals'] = <just-read
 local>, pure no-op mutations. The model functions now treat args as
 read-only, the precondition for Phase 2 atom extraction. Verified: 26/26;
 value AND gradient golden pins bit-identical (loglik + d loglik / d {a_0,
 alpha, beta, sigmax_2, z_*} across hawkes / cox_hawkes / lgcp).

---
 bstpp/inference_functions.py | 10 +---------
 1 file changed, 1 insertion(+), 9 deletions(-)

diff --git a/bstpp/inference_functions.py b/bstpp/inference_functions.py
index 7d55c84..8b1e087 100644
--- a/bstpp/inference_functions.py
+++ b/bstpp/inference_functions.py
@@ -112,11 +112,8 @@ def spatiotemporal_hawkes_model(args):
 
       # Calculate spatial intensity
       if 'spatial_cov' in args:
-          spatial_cov = args['spatial_cov']
-          if spatial_cov.ndim == 1:
-              spatial_cov = spatial_cov[:, None]
-          args['spatial_cov'] = spatial_cov
           # weights for linear combination
+          # (args['spatial_cov'] is guaranteed 2-D by the constructor: X_s[:, None])
           w = numpyro.sample("w", args['priors']['w'])
           b_0 = numpyro.deterministic("b_0", args['spatial_cov'] @ w)
 
@@ -160,11 +157,6 @@ def spatiotemporal_hawkes_model(args):
 
     T,x_min,x_max,y_min,y_max = args['T'],args['x_min'],args['x_max'],args['y_min'],args['y_max']
 
-    args['coords'] = coords
-    args['t_vals'] = t_vals
-    args['x_vals'] = x_vals
-    args['y_vals'] = y_vals
-
     # Temporal trigger: use coords and t_vals
     _, t_trigger_vals = args['t_trig'].compute_trigger(t_pars, (coords, t_vals))
 
